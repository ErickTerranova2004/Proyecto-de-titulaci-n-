# Copie este archivo como backend/.env y complete los valores.
# backend/.env NO debe subirse a ningún repositorio.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Token de GitHub de solo lectura (fine-grained: Actions read, Contents read,
# Metadata read). Sin token el límite es de 60 solicitudes por hora.
GITHUB_TOKEN=

# PostgreSQL. Si POSTGRES_DB está vacío se usa SQLite (solo desarrollo).
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Correo al desarrollador cuando el líder fija una fecha límite (opcional,
# desactivado por defecto). Sin EMAIL_HOST el correo se muestra en la consola.
CORREO_ASIGNACIONES=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
